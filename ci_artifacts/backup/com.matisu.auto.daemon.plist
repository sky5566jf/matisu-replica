<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.matisu.auto.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/Applications/MatisuAuto.app/MatisuAuto</string>
		<string>--daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>mobile</string>
	<key>StandardOutPath</key>
	<string>/var/mobile/matisu_ld.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/matisu_ld.log</string>
</dict>
</plist>
